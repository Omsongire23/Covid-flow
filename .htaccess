# .htaccess — Security and Directory Protection Rules
# Prevent directory browsing
Options -Indexes

# Follow symlinks
Options +FollowSymLinks

# Deny direct web access to sensitive non-public directories and configuration files
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Deny access to sensitive files and folders
  RewriteRule ^(\.git|\.env|config|database|data|includes|storage|tests|docs)(/.*)?$ - [F,L]
  RewriteRule ^(composer\.(json|lock)|docker-compose\.ya?ml|Dockerfile|CLAUDE\.md)$ - [F,L]
</IfModule>

# Fallback FilesMatch protection
<FilesMatch "^(config\.local\.php|schema\.sql|\.gitignore|\.env)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>
